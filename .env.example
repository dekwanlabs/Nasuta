# Host port for the Nasuta HTTP server.
NASUTA_PORT=8201

# Host directory indexed by the container.
NASUTA_WORKSPACE_PATH=./workspace

# Optional runtime overrides. Docker Compose supplies usable defaults when omitted.
# NASUTA_AUTH_TOKEN=replace-me
# NASUTA_HTTP_ADDR=:8201
# NASUTA_SQLITE_PATH=/workspace/.nasuta/index.db
# NASUTA_WORKSPACE_ROOT=/workspace
# Semantic provider defaults to the Qdrant service from docker-compose.
# SEMANTIC_PROVIDER=qdrant
# SEMANTIC_ENDPOINT=qdrant:6334
# SEMANTIC_COLLECTION=knowledge
# SEMANTIC_NAMESPACE=default
# SEMANTIC_API_KEY=
# SEMANTIC_USERNAME=
# SEMANTIC_PASSWORD=
# SEMANTIC_TLS_ENABLED=false
# Legacy Qdrant variables remain supported for existing deployments.
# QDRANT_HOST=qdrant
# QDRANT_PORT=6334
# QDRANT_COLLECTION=knowledge

# Semantic embedding is enabled only when both URL and API key are configured.
EMBEDDING_PROVIDER=openai
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# MySQL-backed authentication, settings, RBAC, and incident workflows are optional.
MYSQL_DSN=
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_REDIRECT_URI=
